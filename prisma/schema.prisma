// Schéma canonique (PostgreSQL / Neon). En développement sans DATABASE_URL,
// scripts/db.mjs en dérive automatiquement une variante SQLite (prisma/.dev/).
// Rester compatible SQLite : pas d'enum ni de tableaux natifs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  slug      String    @id
  name      String
  nameEn    String
  /// Ordre d'affichage dans le menu et les filtres
  sortOrder Int       @default(0)
  products  Product[]
}

model Creator {
  slug        String    @id
  name        String
  specialty   String
  specialtyEn String
  bio         String
  bioEn       String
  image       String
  /// Article source de la biographie (G3A)
  sourceUrl   String
  products    Product[]
}

model Product {
  slug               String      @id
  name               String
  nameEn             String
  description        String
  descriptionEn      String
  story              String
  storyEn            String
  categorySlug       String
  category           Category    @relation(fields: [categorySlug], references: [slug])
  creatorSlug        String
  creator            Creator     @relation(fields: [creatorSlug], references: [slug])
  /// Prix en centimes d'EUR
  priceCents         Int
  /// [{ fr, en }]
  materials          Json
  /// string[] ; vide si pièce sans taille (tailles S/M/L, tour de doigt)
  sizes              Json
  /// Texte libre historique ; préférer widthCm/heightCm/depthCm
  dimensions         String?
  /// Matière principale (filtre) et technique, FR/EN
  material           String?
  materialEn         String?
  technique          String?
  techniqueEn        String?
  /// Origine géographique (filtre pays/région)
  country            String?
  countryEn          String?
  region             String?
  regionEn           String?
  /// Dimensions en cm (peinture, sculpture, photographie)
  widthCm            Float?
  heightCm           Float?
  depthCm            Float?
  /// Conseils d'entretien (couture)
  careInstructions   String?
  careInstructionsEn String?
  hasCertificate     Boolean     @default(true)
  stock              Int
  /// string[] de chemins publics
  images             Json
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]

  @@index([categorySlug])
  @@index([creatorSlug])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  orders       Order[]
  addresses    Address[]
  /// Alertes e-mail sur les favoris (baisse de prix, dernière pièce, retour en stock)
  alertFavorites Boolean  @default(false)
  /// E-mail « Nouvelles pièces » ; promoSince = point de départ (pièces créées après)
  alertPromo     Boolean  @default(false)
  promoSince     DateTime?
  lastTestEmailAt DateTime?
  favorites      Favorite[]
  pushSubscriptions PushSubscription[]
  supplier       Supplier?
  supplierApplications SupplierApplication[]
}

/// Fournisseur (couturier ou artiste) ; userId nul pour un fournisseur de démonstration (seed).
/// status : ACTIVE | SUSPENDED. commissionRate : part retenue par la plateforme (0.15 = 15 %).
model Supplier {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName    String
  country        String
  craftType      String
  bio            String   @default("")
  bioEn          String   @default("")
  videoUrl       String?
  creatorSlug    String?
  status         String   @default("ACTIVE")
  commissionRate Float    @default(0.15)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

/// Candidature fournisseur. status : PENDING | NEEDS_INFO | ACCEPTED | REFUSED.
model SupplierApplication {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String
  country      String
  craftType    String
  portfolioUrl String
  about        String
  locale       String    @default("fr")
  status       String    @default("PENDING")
  adminNote    String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  @@index([userId])
  @@index([status])
}

/// Abonnements Web Push (un par navigateur/appareil) ; supprimés si le service push répond 404/410
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("fr")
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Favoris synchronisés des comptes connectés ; lastPriceCents/lastStock = dernier état notifié (anti-doublon)
model Favorite {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug    String
  lastPriceCents Int
  lastStock      Int
  createdAt      DateTime @default(now())

  @@id([userId, productSlug])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  firstName  String   @default("")
  lastName   String   @default("")
  line1      String
  houseNumber String  @default("")
  box        String?
  line2      String?
  phone      String   @default("")
  isDefault  Boolean  @default(false)
  postalCode String
  city       String
  country    String
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Order {
  id         String      @id @default(cuid())
  /// Null pour une commande invitée
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Référence lisible affichée au client
  number     String      @unique
  locale     String
  email      String
  fullName   String
  address    String
  postalCode String
  city       String
  country    String
  phone      String      @default("")
  street     String      @default("")
  houseNumber String     @default("")
  box        String?
  complement String?
  /// Jeton permettant à un invité de modifier l'adresse tant que la commande n'est pas expédiée
  editToken  String?
  totalCents Int
  /// Statut simulé ; étendu en partie 2 (suivi de commande)
  status     String      @default("PLACED")
  createdAt  DateTime    @default(now())
  items      OrderItem[]

  @@index([userId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug    String
  product        Product @relation(fields: [productSlug], references: [slug])
  name           String
  size           String?
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}
