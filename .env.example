# Copier vers .env.local en local (ignoré par git). Sur Vercel : Settings > Environment Variables.
# Ne jamais commiter de valeur réelle.

# Chaîne de connexion PostgreSQL (Neon, version « pooled »). Si absente en local : base SQLite de dev.
DATABASE_URL=
# Optionnel : chaîne Neon directe (non poolée), utilisée seulement par `npm run db:deploy`.
DIRECT_URL=

# Secret Auth.js (session des comptes). Obligatoire en production : `npx auth secret` ou `openssl rand -base64 32`.
AUTH_SECRET=

# URL publique du site (ex. https://mon-site.vercel.app), sans barre finale.
AUTH_URL=

# Connexion sociale (optionnelle). Un bouton n'est actif que si l'ID ET le secret sont renseignés ; sinon il affiche « Bientôt ».
# URL de callback : https://epomta-demo.vercel.app/api/auth/callback/<google|facebook|apple>
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Mur de mot de passe de la démo privée. Si SITE_ACCESS_PASSWORD est vide ou absent, le mur est désactivé (local, tests).
SITE_ACCESS_PASSWORD=
# Clé de signature du cookie d'accès (longue chaîne aléatoire, différente des autres secrets).
SITE_ACCESS_SECRET=

# E-mail de confirmation de commande (SMTP Gmail). Optionnel : sans ces deux variables, aucun e-mail n'est envoyé.
GMAIL_USER=
# Mot de passe d'application Google (16 caractères), jamais le mot de passe du compte.
GMAIL_APP_PASSWORD=

# Saisie guidée des adresses : par défaut Photon (Komoot, OpenStreetMap), sans clé. Si cette clé existe, Google Places (New) est utilisé à la place. Clé serveur, restreinte à « Places API (New) ».
GOOGLE_PLACES_API_KEY=

# Alertes e-mail : secret du cron /api/alerts/run (Vercel l'envoie en Bearer). Resend (optionnel, prioritaire sur Gmail) : cle + expediteur verifie.
CRON_SECRET=
# Web Push (optionnel : sans ces 3 variables l'interrupteur push reste « Bientôt »). Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Administrateurs (e-mails séparés par des virgules) : accès /admin et sélecteur de vue.
ADMIN_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=
