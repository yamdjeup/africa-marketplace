# Copier vers .env.local (ignoré par git). Ne jamais commiter de valeur réelle.
# Chaîne de connexion PostgreSQL (Neon). Si absente, une base SQLite locale est utilisée en développement.
DATABASE_URL=

# Secret Auth.js (session JWT) : generer avec `npx auth secret` ou `openssl rand -base64 32`. Obligatoire en production.
AUTH_SECRET=
