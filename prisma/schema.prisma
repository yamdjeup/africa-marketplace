// Schéma canonique (PostgreSQL / Neon). En développement sans DATABASE_URL,
// scripts/db.mjs en dérive automatiquement une variante SQLite (prisma/.dev/).
// Rester compatible SQLite : pas d'enum ni de tableaux natifs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  slug      String    @id
  name      String
  nameEn    String
  /// Ordre d'affichage dans le menu et les filtres
  sortOrder Int       @default(0)
  products  Product[]
}

model Creator {
  slug        String    @id
  name        String
  specialty   String
  specialtyEn String
  bio         String
  bioEn       String
  image       String
  /// Article source de la biographie (G3A)
  sourceUrl   String
  products    Product[]
}

/// Anciens slugs de pages boutique (renommées) : redirection permanente vers le slug actuel.
model CreatorSlugAlias {
  oldSlug     String @id
  creatorSlug String

  @@index([creatorSlug])
}

model Product {
  slug               String      @id
  name               String
  nameEn             String
  description        String
  descriptionEn      String
  /// Langue saisie par le partenaire (fr|en) ; translationState : "" (manuel) | "auto" | "pending" (traduction à venir)
  sourceLang         String      @default("fr")
  translationState   String      @default("")
  story              String
  storyEn            String
  categorySlug       String
  category           Category    @relation(fields: [categorySlug], references: [slug])
  creatorSlug        String
  creator            Creator     @relation(fields: [creatorSlug], references: [slug])
  /// Prix en centimes d'EUR
  priceCents         Int
  /// [{ fr, en }]
  materials          Json
  /// string[] ; vide si pièce sans taille (tailles S/M/L, tour de doigt)
  sizes              Json
  /// Texte libre historique ; préférer widthCm/heightCm/depthCm
  dimensions         String?
  /// Matière principale (filtre) et technique, FR/EN
  material           String?
  materialEn         String?
  technique          String?
  techniqueEn        String?
  /// Origine géographique (filtre pays/région)
  country            String?
  countryEn          String?
  region             String?
  regionEn           String?
  /// Dimensions en cm (peinture, sculpture, photographie)
  widthCm            Float?
  heightCm           Float?
  depthCm            Float?
  /// Conseils d'entretien (couture)
  careInstructions   String?
  careInstructionsEn String?
  hasCertificate     Boolean     @default(true)
  stock              Int
  /// string[] de chemins publics
  images             Json
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]
  /// Partenaire propriétaire ; nul pour le catalogue historique
  supplierId         String?
  /// DRAFT | SUBMITTED | PUBLISHED | REJECTED (seules les PUBLISHED sont publiques)
  status             String      @default("PUBLISHED")
  /// Stock réservé par des commandes en cours ; disponible = stock - reserved
  reserved           Int         @default(0)
  lowStockThreshold  Int         @default(1)
  /// Prix saisi par le partenaire (unité mineure de la devise) ; priceCents reste le prix EUR affiché
  currency           String      @default("EUR")
  priceLocal         Int?
  weightG            Int?
  /// Art uniquement, facultatif : « Pièce unique » ou « x/y »
  edition            String?
  signatureFileId    String?
  authorAttestedAt   DateTime?
  authorAttestedBy   String?
  rejectReason       String?
  submittedAt        DateTime?
  decidedAt          DateTime?
  /// E-mail de l'admin qui a saisi l'œuvre au nom du partenaire (null = saisie par le partenaire).
  createdByAdmin     String?
  variants           ProductVariant[]

  @@index([categorySlug])
  @@index([creatorSlug])
  @@index([supplierId])
  @@index([status])
}

/// Variante (taille/couleur) avec son propre stock ; son libellé est utilisé comme « taille » dans le panier.
model ProductVariant {
  id          String  @id @default(cuid())
  productSlug String
  product     Product @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  label       String
  stock       Int     @default(0)
  reserved    Int     @default(0)

  @@index([productSlug])
}

/// Historique des mouvements de stock. type : ENTRY | RESERVE | RELEASE | SALE | RETURN | ADJUST ; quantity signée (effet sur le stock disponible).
model StockMovement {
  id          String   @id @default(cuid())
  productSlug String
  variantId   String?
  type        String
  quantity    Int
  reason      String   @default("")
  authorId    String?
  authorLabel String   @default("")
  orderNumber String?
  createdAt   DateTime @default(now())

  @@index([productSlug])
}

/// Fichier média (photo d'œuvre, signature) servi par /api/media/[id] ; remplaçable par Vercel Blob (voir lib/storage.ts).
model MediaFile {
  id          String   @id @default(cuid())
  ownerUserId String?
  name        String
  mime        String
  size        Int
  isPrivate   Boolean  @default(false)
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([ownerUserId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  orders       Order[]
  addresses    Address[]
  /// Alertes e-mail sur les favoris (baisse de prix, dernière pièce, retour en stock)
  alertFavorites Boolean  @default(false)
  /// E-mail « Nouvelles pièces » ; promoSince = point de départ (pièces créées après)
  alertPromo     Boolean  @default(false)
  promoSince     DateTime?
  lastTestEmailAt DateTime?
  favorites      Favorite[]
  pushSubscriptions PushSubscription[]
  supplier       Supplier?
  supplierApplications SupplierApplication[]
}

/// Fournisseur (couturier ou artiste) ; userId nul pour un fournisseur de démonstration (seed).
/// status : ACTIVE | SUSPENDED. commissionRate : part retenue par la plateforme (0.15 = 15 %).
model Supplier {
  id             String   @id @default(cuid())
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName    String
  country        String
  craftType      String
  bio            String   @default("")
  bioEn          String   @default("")
  videoUrl       String?
  creatorSlug    String?
  status         String   @default("ACTIVE")
  commissionRate Float    @default(0.15)
  isDemo         Boolean  @default(false)
  /// Signature de l'artiste (MediaFile privé), enregistrée une seule fois
  signatureFileId String?
  createdAt      DateTime @default(now())
}

/// Journal d'audit des actions admin sur un partenaire : SUSPEND | REACTIVATE | REVOKE.
model PartnerAudit {
  id         String   @id @default(cuid())
  supplierId String
  action     String
  reason     String   @default("")
  actorEmail String
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

/// Candidature fournisseur. status : PENDING | NEEDS_INFO | ACCEPTED | REFUSED.
model SupplierApplication {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String
  country      String
  craftType    String
  portfolioUrl String
  about        String
  locale       String    @default("fr")
  status       String    @default("PENDING")
  adminNote    String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  @@index([userId])
  @@index([status])
}

/// Fichier joint à une candidature (image ou PDF). applicationId nul tant que la candidature n'est pas envoyée.
model ApplicationFile {
  id            String   @id @default(cuid())
  userId        String
  applicationId String?
  name          String
  mime          String
  size          Int
  data          Bytes
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([applicationId])
}

/// Abonnements Web Push (un par navigateur/appareil) ; supprimés si le service push répond 404/410
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("fr")
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Favoris synchronisés des comptes connectés ; lastPriceCents/lastStock = dernier état notifié (anti-doublon)
model Favorite {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug    String
  lastPriceCents Int
  lastStock      Int
  createdAt      DateTime @default(now())

  @@id([userId, productSlug])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  firstName  String   @default("")
  lastName   String   @default("")
  line1      String
  houseNumber String  @default("")
  box        String?
  line2      String?
  phone      String   @default("")
  isDefault  Boolean  @default(false)
  postalCode String
  city       String
  country    String
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Order {
  id         String      @id @default(cuid())
  /// Null pour une commande invitée
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Référence lisible affichée au client
  number     String      @unique
  locale     String
  email      String
  fullName   String
  address    String
  postalCode String
  city       String
  country    String
  phone      String      @default("")
  street     String      @default("")
  houseNumber String     @default("")
  box        String?
  complement String?
  /// Jeton permettant à un invité de modifier l'adresse tant que la commande n'est pas expédiée
  editToken  String?
  /// Identifiant du paiement Stripe (pi_…) lorsqu'un paiement Stripe est enregistré ; null sinon
  stripePaymentIntentId String?
  /// Session Stripe Checkout ; renseignée tant que le paiement n'est pas confirmé
  stripeSessionId String?
  /// Vrai entre la création de la commande et la confirmation du paiement par Stripe
  paymentPending Boolean @default(false)
  totalCents Int
  /// Statut simulé ; étendu en partie 2 (suivi de commande)
  status     String      @default("PLACED")
  createdAt  DateTime    @default(now())
  items      OrderItem[]
  subOrders  SubOrder[]

  @@index([userId])
}

/// Sous-commande par partenaire (le vendeur est la boutique). status : PENDING | ACCEPTED | PREPARING | SHIPPED | DELIVERED | REFUSED | EXPIRED | CANCELLED.
model SubOrder {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId     String
  number         String    @unique
  status         String    @default("PENDING")
  subtotalCents  Int
  /// Échéance de réponse du partenaire (48 h)
  acceptBy       DateTime
  reminderSentAt DateTime?
  escalatedAt    DateTime?
  decidedAt      DateTime?
  reason         String    @default("")
  carrier        String    @default("")
  trackingNumber String    @default("")
  /// Remboursement à l'annulation : "" (aucun) | REQUESTED | DONE | FAILED | MANUAL (à traiter par l'admin)
  refundStatus   String    @default("")
  refundId       String?
  /// Détail exploitable d'un remboursement en échec ou en attente de paiement
  refundNote String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([orderId])
  @@index([supplierId, status])
}

/// Registre (mode test, aucun argent réel) : créé à la livraison d'une sous-commande.
/// grossCents = montant client, commissionCents = commission plateforme, netCents = part boutique. Disponible dès availableAt ; versé quand payoutId est renseigné.
model LedgerEntry {
  id              String    @id @default(cuid())
  supplierId      String
  subOrderId      String    @unique
  grossCents      Int
  commissionRate  Float
  commissionCents Int
  netCents        Int
  availableAt     DateTime
  payoutId        String?
  reversedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([supplierId, payoutId])
}

/// Versement (test) marqué effectué par l'admin.
model Payout {
  id          String   @id @default(cuid())
  supplierId  String
  amountCents Int
  entryCount  Int
  reference   String
  paidBy      String
  paidAt      DateTime @default(now())

  @@index([supplierId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug    String
  product        Product @relation(fields: [productSlug], references: [slug])
  name           String
  size           String?
  quantity       Int
  unitPriceCents Int
  subOrderId     String?

  @@index([orderId])
  @@index([subOrderId])
}
