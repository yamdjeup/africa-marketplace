{
  "expo": {
    "name": "Epomta",
    "slug": "epomta",
    "scheme": "epomta",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "enabled": true, "checkAutomatically": "ON_LOAD", "fallbackToCacheTimeout": 0 },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-1024.png",
    "plugins": [
      "expo-notifications",
      ["expo-image-picker", { "photosPermission": "Epomta utilise vos photos pour illustrer vos œuvres et votre profil." }],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "com.epomta.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.epomta.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
